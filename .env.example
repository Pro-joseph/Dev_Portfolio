# Local development database (Docker Postgres)
DATABASE_URL=postgres://portfolio:portfolio@localhost:5432/portfolio_dev

# Test database (ephemeral, recreated by vitest global setup)
TEST_DATABASE_URL=postgres://portfolio:portfolio@localhost:5432/portfolio_test

# Secrets
JWT_SECRET=dev-secret-change-me

# Public API base (same-origin in production)
NEXT_PUBLIC_API_URL=/api/v1

# Local filesystem root for media uploads (resolved against app root)
MEDIA_UPLOAD_DIR=public/uploads