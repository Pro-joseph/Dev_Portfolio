# --- Database ---
# SQLite file (relative to app root; ":memory:" for ephemeral). Used when
# DATABASE_URL is NOT set (local dev + tests).
DB_FILE=data/portfolio.db

# Postgres/Supabase connection string. When set, the app uses Postgres
# instead of SQLite and applies data/schema.postgres.sql + seeds on first boot.
# For Vercel, use the Supabase pooler URL (Settings -> Database -> Connection
# string -> Transaction pooler / Session pooler).
DATABASE_URL=

# TLS for Postgres. Auto-derived from `?sslmode=` in DATABASE_URL (default:
# require for remote hosts, off for localhost). Set to "false" to force TLS off
# (e.g. a local Docker Postgres without SSL).
DATABASE_SSL=

# --- Supabase (media storage) ---
# Server-side project credentials. When SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY
# are set, media uploads go to a Supabase Storage bucket instead of the local
# filesystem. Use the service_role key (server-only, never expose to the client).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=media

# --- App ---
# Secrets (generate a strong random value for production, e.g. `openssl rand -hex 32`)
JWT_SECRET=dev-secret-change-me

# Public API base (same-origin in production)
NEXT_PUBLIC_API_URL=/api/v1

# Local filesystem root for media uploads (resolved against app root).
# Only used when Supabase storage is not configured.
MEDIA_UPLOAD_DIR=public/uploads

# Media quota shown in the admin dashboard (bytes)
MEDIA_QUOTA_BYTES=6442450944